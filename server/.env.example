# Copy this file to .env and fill in your keys (test mode first!)

# Stripe → https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# After `stripe listen --forward-to localhost:4242/webhook`
# or from your dashboard webhook config:
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: path to a Firebase service-account JSON so completed
# purchases are recorded in Firestore server-side:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

PORT=4242

# Admin dashboard password (http://localhost:4242/admin.html)
ADMIN_PASSWORD=rainbowadmin
