rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users may read/write only their own profile (membership, plots, decor)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Plot registry is public to read (availability map); only the
    // server (Admin SDK) writes ownership after verified payment.
    match /plots/{plotId} {
      allow read: if true;
      allow write: if false;
    }
    // Purchases are written by the server only.
    match /purchases/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
